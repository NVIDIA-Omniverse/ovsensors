#include <windows.h>
#include <delayimp.h>

#include <cstring>
#include <string>
#include <system_error>

namespace
{
FARPROC WINAPI loadSelectedRuntime(unsigned notification, PDelayLoadInfo info)
{
    if (notification != dliNotePreLoadLibrary)
        return nullptr;

    const struct
    {
        const char* name;
        const wchar_t* path;
    } libraries[] = {
        { "$<TARGET_FILE_NAME:ovsensors::ovsensors>", LR"dll($<TARGET_FILE:ovsensors::ovsensors>)dll" },
        { "$<TARGET_FILE_NAME:ovsensors::provider_ovrtx>", LR"dll($<TARGET_FILE:ovsensors::provider_ovrtx>)dll" },
        { "$<TARGET_FILE_NAME:ovrtx::ovrtx>", LR"dll($<TARGET_FILE:ovrtx::ovrtx>)dll" },
        { "$<TARGET_FILE_NAME:ovstage::ovstage>", LR"dll($<TARGET_FILE:ovstage::ovstage>)dll" },
    };
    for (const auto& library : libraries)
    {
        if (std::strcmp(info->szDll, library.name) != 0)
            continue;

        // CMake emits forward slashes; the Windows loader expects native paths.
        std::wstring path(library.path);
        for (auto& character : path)
            if (character == L'/')
                character = L'\\';
        const HMODULE module = LoadLibraryExW(
            path.c_str(), nullptr, LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
        if (!module)
        {
            const DWORD error = GetLastError();
            // Returning nullptr here would let delayimp search for another DLL.
            throw std::system_error(static_cast<int>(error), std::system_category(), library.name);
        }
        return reinterpret_cast<FARPROC>(module);
    }
    return nullptr;
}
} // namespace

extern "C" const PfnDliHook __pfnDliNotifyHook2 = loadSelectedRuntime;
